###############################################################################
# Dockerfile.fork — self-contained build for the Appsmith fork.
#
# Produces the same runtime image as the upstream pipeline but builds
# everything (base layer, server, client, RTS) in a single multi-stage
# Dockerfile so there is no dependency on Depot, DockerHub credentials,
# or pre-built base images.
#
# Usage:
#   docker build -f Dockerfile.fork -t ghcr.io/OWNER/appsmith:latest .
###############################################################################

# ─── Stage 1: Caddy with rate-limit plugin ──────────────────────────────────
FROM caddy:builder-alpine AS caddybuilder
RUN xcaddy build --with github.com/mholt/caddy-ratelimit

# ─── Stage 2: Build server JAR (Java 17 + Maven) ────────────────────────────
FROM eclipse-temurin:17-jdk AS server-builder
RUN apt-get update && apt-get install -y maven nodejs npm git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY app/server app/server
RUN cd app/server && node scripts/check-field-constants.mjs && mvn clean package -DskipTests -Dmaven.test.skip=true -q
RUN mkdir -p /artifacts/server/mongo \
  && cp app/server/appsmith-server/target/server-*.jar /artifacts/server/mongo/server.jar \
  && find app/server/appsmith-plugins/*/target -name "*.jar" ! -name "original-*" -exec cp {} /artifacts/server/mongo/ \;

# ─── Stage 3: Build client + RTS (Node 20 + Yarn) ───────────────────────────
# RTS lives inside the Yarn workspace and shares dependencies with the client,
# so both are built in a single stage to avoid workspace resolution errors.
FROM node:20.11.1 AS client-builder
WORKDIR /build
COPY app/client app/client
RUN corepack enable \
  && cd app/client \
  && yarn install \
  && REACT_APP_ENVIRONMENT=PRODUCTION \
     REACT_APP_CLIENT_LOG_LEVEL=ERROR \
     node --max-old-space-size=8192 scripts/build.js \
  && cd packages/rts \
  && rm -rf dist && yarn run tsc --noEmit && node build.js

# ─── Stage 5: Generate info.json ────────────────────────────────────────────
FROM ubuntu:24.04 AS info-gen
RUN apt-get update && apt-get install -y jq git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY .git .git
COPY scripts/generate_info_json.sh scripts/generate_info_json.sh
COPY deploy/docker/fs deploy/docker/fs
RUN bash scripts/generate_info_json.sh

# ─── Stage 6: Runtime image (mirrors upstream base.dockerfile) ───────────────
FROM ubuntu:24.04

LABEL maintainer="fork"
WORKDIR /opt/appsmith

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN set -o xtrace \
  && apt-get update \
  && apt-get upgrade --yes \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes \
    supervisor curl nfs-common gnupg gettext ca-certificates libnss-wrapper git \
    tar zstd openssh-client software-properties-common \
  && add-apt-repository -y ppa:git-core/ppa \
  && apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes git \
  && curl -fsSL https://www.mongodb.org/static/pgp/server-6.0.asc | gpg --dearmor -o /usr/share/keyrings/mongodb-server-6.0.gpg \
  && echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-6.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/6.0 multiverse" \
     | tee /etc/apt/sources.list.d/mongodb-org-6.0.list \
  && echo "deb http://apt.postgresql.org/pub/repos/apt $(grep CODENAME /etc/lsb-release | cut -d= -f2)-pgdg main" \
     | tee /etc/apt/sources.list.d/pgdg.list \
  && curl --silent --show-error --location https://www.postgresql.org/media/keys/ACCC4CF8.asc | apt-key add - \
  && apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes \
     mongodb-org redis postgresql-14 \
  && find /etc/redis -type d -exec chmod o+rx {} + -o -type f -exec chmod o+r {} + \
  && apt-get clean \
  && rm -rf /root/.cache /root/.npm /usr/local/share/doc /usr/share/doc /usr/share/man /var/lib/apt/lists/* /tmp/*

ENV PATH="/usr/lib/postgresql/14/bin:${PATH}"

# Java 17
RUN mkdir -p /opt/java \
  && arch="$(uname -m | sed 's/x86_64/x64/; s/aarch64/aarch64/')" \
  && curl --location "https://api.adoptium.net/v3/binary/latest/17/ga/linux/${arch}/jdk/hotspot/normal/eclipse" \
     | tar -xz -C /opt/java --strip-components 1

# Node 20
RUN set -eo xtrace \
  && mkdir -p /opt/node \
  && arch="$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/')" \
  && curl -LOsS "https://nodejs.org/dist/latest-v20.x/SHASUMS256.txt" \
  && filename="$(awk '/linux-'"$arch"'.tar.gz/ {print $2}' SHASUMS256.txt)" \
  && curl -LOsS "https://nodejs.org/dist/latest-v20.x/$filename" \
  && grep "$filename" SHASUMS256.txt | sha256sum -c - \
  && tar -xzf "$filename" -C /opt/node --strip-components 1 \
  && rm "$filename" SHASUMS256.txt

# Caddy
RUN mkdir -p /opt/caddy \
  && version="$(curl --write-out '%{redirect_url}' 'https://github.com/caddyserver/caddy/releases/latest' | sed 's,.*/v,,')" \
  && curl --location "https://github.com/caddyserver/caddy/releases/download/v$version/caddy_${version}_linux_$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/').tar.gz" \
     | tar -xz -C /opt/caddy \
  && mv /opt/caddy/caddy /opt/caddy/caddy_vanilla

COPY --from=caddybuilder /usr/bin/caddy /opt/caddy/caddy

VOLUME [ "/appsmith-stacks" ]
ENV TMP="/tmp/appsmith"
ENV WWW_PATH="$TMP/www"

ENV NSS_WRAPPER_SYMLINK=/usr/local/lib/libnss_wrapper.so
RUN NSS_WRAPPER_LIB=$(find /usr/lib -name libnss_wrapper.so -type f 2>/dev/null | head -n1) \
  && ln -sf "$NSS_WRAPPER_LIB" $NSS_WRAPPER_SYMLINK
ENV NSS_WRAPPER_PASSWD="${TMP}/passwd"
ENV NSS_WRAPPER_GROUP="${TMP}/group"

ENV IN_DOCKER=1

# Copy filesystem overlay
COPY deploy/docker/fs /

# Copy info.json
COPY --from=info-gen /build/deploy/docker/fs/opt/appsmith/info.json /opt/appsmith/info.json

# Copy server artifacts
COPY --from=server-builder /artifacts/server /opt/appsmith/server

# Copy client build
COPY --from=client-builder /build/app/client/build /opt/appsmith/editor/

# Copy RTS
COPY --from=client-builder /build/app/client/packages/rts/dist /opt/appsmith/rts/

RUN mkdir --mode 775 "/dev/shm/git-storage"

ENV PATH="/opt/bin:/opt/java/bin:/opt/node/bin:$PATH"

RUN set -o errexit \
  && find . \( -name node_modules -prune \) -o \( -type f -name '*.sh' \) -exec chmod +x '{}' + \
  && chmod +x /opt/bin/* /watchtower-hooks/*.sh \
  && find / \( -path /proc -prune \) -o \( \( -perm -2000 -o -perm -4000 \) -exec chmod -s '{}' + \) || true \
  && mkdir -p /.mongodb/mongosh /appsmith-stacks \
  && chmod ugo+w /etc /appsmith-stacks \
  && chmod -R ugo+w /var/run /.mongodb /etc/ssl /usr/local/share

LABEL com.centurylinklabs.watchtower.lifecycle.pre-check=/watchtower-hooks/pre-check.sh
LABEL com.centurylinklabs.watchtower.lifecycle.pre-update=/watchtower-hooks/pre-update.sh

EXPOSE 80
EXPOSE 443
ENTRYPOINT [ "/opt/appsmith/entrypoint.sh" ]
HEALTHCHECK --interval=15s --timeout=15s --start-period=45s CMD "/opt/appsmith/healthcheck.sh"
CMD ["/usr/bin/supervisord", "-n"]
